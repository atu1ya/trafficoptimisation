[Unit]
Description=Perth Greenwave Backend
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/opt/perth-greenwave
Environment=PYTHONPATH=/opt/perth-greenwave/backend
ExecStart=/opt/perth-greenwave/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always

[Install]
WantedBy=multi-user.target
